#!/usr/bin/env bash
#
# delegate-fire: start a new /loop /delegate chain when one is needed, from a
# host that cannot run the delegator itself (a GitHub Actions cron).
#
# A chain hands itself on from session to session, but some exits end it for
# good (a full lease, a failed hand-off, a session the human closed), and
# nothing starts a new one. A session started by a scheduled task cannot call
# create_session, so the spawner cannot be a skill. This script is the gate
# instead: it asks `delegate-status next-action` and `lease status` what a
# chain would do (plain gh and jq, no tokens), and only when there is work a
# new session could do does it POST to a scheduled task's API trigger. That
# task's prompt is /delegate loop, so the session it starts is the new chain,
# and its own `lease take` settles any race.
#
# Without --reserve it fires at most once per run:
#   pick           fires when the lease has a free slot: the lease caps new
#                  work;
#   watch or land  fires whatever the lease holds. The gate reports these
#                  only for a PR no session holds a claim on, and a live
#                  chain acts only on its own ticket's PR, so nothing else
#                  would reach it. On a full lease the fired session's Run
#                  does a finish-only pass;
#   idle           never fires.
#
# With --reserve (DELEGATE_FIRE_RESERVE_TOKEN writes as the delegator's
# login; the gate's reads keep GH_TOKEN) it fills
# every free slot that has work in one run. For each issue `next-action
# --picks` lists, up to the free slots, it names a new session, takes a
# lease slot and sets the issue's ticket marker in that name, and fires with
# a hand-off line naming both, so the session starts holding them and no
# other session can pick the issue. A pick it cannot reserve is skipped. When
# a PR no session holds needs finishing, it fires one more session, holding
# nothing, for all of them.
#
# Before any fire that would finish PRs (the one fire for watch or land,
# and the finishing session under --reserve), it re-reads each PR's live
# claim with `delegate-status holder` and leaves out the claimed ones. A
# Ready click both starts this workflow and wakes the PR's own subscribed
# session, which claims the PR to land it, so the gate's first read can be
# stale by the time it fires. With none left it fires nothing for them (a
# one-fire run with a pick and a free slot fires for the pick instead).
#
# With weekdays_only on in the settings it fires nothing on a Saturday or
# Sunday (UTC), unless forced.
#
# Team routing. With a `roster` in the settings (the logins taking part,
# each running the delegator as themselves with their own scheduled task and
# trigger), every run fires at most one teammate's trigger per event, so no
# second session wakes only to find a claim and stop. Credentials come from
# DELEGATE_FIRE_TRIGGERS, one JSON object mapping each login to {url, token,
# reserve_token?}; a roster login with no entry is reported, never fired.
# Each login's gate runs as that login (DELEGATE_STATUS_LOGIN) under strict
# assignee routing: only issues assigned to that login alone, and PRs it
# opened. The event decides whose gate runs:
#   --event issues --action labeled, with --label the `label` parameter:
#                  the issue's one human assignee; with none, the --sender,
#                  who is assigned first. Several assignees, or an owner not
#                  on the roster, fire nothing and say why. Any other label
#                  is ignored;
#   --event pull_request (ready_for_review, closed) or pull_request_review
#                  (submitted): the PR's --author, when its --head starts
#                  with `branch_prefix`; the holder re-check still applies;
#   --event pull_request --action review_requested, with --reviewer the
#                  requested login and `rereview` on: that reviewer's
#                  `review_url` trigger, with the text
#                  `<rereview_command> <owner/repo>#<n>`, when the PR is
#                  delegated, the reviewer is on the roster and is not its
#                  author, their latest submitted review-requests review on
#                  it was of an older head, and a blocking or should-fix
#                  thread it opened is still unresolved (`delegate-status
#                  rereview`). The delegator re-requests that review after
#                  answering such a thread, so each round wakes the reviewer
#                  once, and a round that leaves none open ends the exchange;
#   --event schedule, workflow_dispatch or none: every roster login in
#                  turn, after assigning each unassigned labelled issue to
#                  the actor of its latest `labeled` event, when that actor
#                  is on the roster. Any other is skipped and reported.
# Assigning is the lock between logins: it uses GH_TOKEN (the workflow
# token, which needs issues: write), and the workflow's concurrency group
# runs one gate at a time. A login reserves (as --reserve) only when its
# entry has a reserve_token, else it gets at most one fire per run; --reserve
# itself is ignored. With `max_chains_per_login` set, a login whose lease
# slots (counted by claim author) are at that cap is fired no pick;
# `max_chains` stays the overall cap, and a run's unreserved fires count
# against it. Each login gets one report line.
#
# Run it from the project's checkout. The project's .claude/delegation.md
# supplies the same parameters `/delegate` reads; without one it refuses to
# start. Setup: references/delegate-fire.md.
#
# Usage:
#   delegate-fire [--repo <owner/repo>] [--reserve] [--force] [--dry-run]
#                 [--event <name> [--action <a>] [--number <n>] [--label <l>]
#                  [--sender <login>] [--author <login>] [--head <branch>]
#                  [--reviewer <login>]]
#
# Options:
#   --repo <owner/repo>   default: the origin remote
#   --reserve             fill every free slot, reserving each one first;
#                         DELEGATE_FIRE_RESERVE_TOKEN (else GH_TOKEN) must
#                         write issues as the delegator's login
#   --force               fire whatever the gate says (to test the trigger)
#   --dry-run             decide and report, but never assign or fire; needs
#                         no secrets
#   --event <name>        with a roster: the GitHub event that started the
#                         run (github.event_name); --action its action, and
#                         --number, --label, --sender, --author and --head
#                         the issue or PR number, the label added, the event's
#                         sender, and the PR's author and branch; --reviewer
#                         the login a review_requested event asks. Ignored
#                         without a roster
#
# Settings (.claude/delegation.md Parameters table), beyond /delegate's own:
#   weekdays_only         on: fire nothing on Saturday or Sunday (UTC)
#   assignee_routing      off|on|strict, passed to the gate (a roster gate
#                         always runs strict)
#   roster                the logins taking part, comma-separated
#   max_chains_per_login  the most lease slots one login may hold before it
#                         is fired no pick
#   rereview              on: route review_requested to the reviewer's
#                         review_url trigger (with a roster); default off
#   rereview_command      the fire's text before <owner/repo>#<n>; default
#                         /review-requests
#
# Environment:
#   DELEGATE_FIRE_URL     the scheduled task's API trigger URL (no roster)
#   DELEGATE_FIRE_TOKEN   the trigger's bearer token (no roster)
#   DELEGATE_FIRE_TRIGGERS
#                         with a roster: {"<login>": {"url": …, "token": …,
#                         "reserve_token": …, "review_url": …,
#                         "review_token": …}, …}; all but url and token are
#                         optional. review_url and review_token are the
#                         login's review-requests task's trigger
#   GH_TOKEN              read access to the repository's issues and PRs;
#                         with a roster, issues write too, to assign
#   DELEGATE_FIRE_RESERVE_TOKEN
#                         with --reserve, the token the reservations use:
#                         issues read and write, pull requests read, as the
#                         delegator's login. Unset, GH_TOKEN does both jobs
#   DELEGATE_STATUS_LOGIN the login the delegator posts as; required when
#                         GH_TOKEN is no user (a GitHub Actions token). A
#                         roster gate sets it to each login itself
#
# It prints one report line (with a roster, one per routing decision and one
# per login), which also goes to $GITHUB_STEP_SUMMARY, and writes
# fired=true|false to $GITHUB_OUTPUT when they are set. Exit status:
# 0 fired or nothing to do, 1 a gate, reservation or trigger failure (with
# --reserve or a roster, after firing every other session), 2 usage.
# DELEGATE_STATUS overrides the bookkeeping script, DELEGATE_STATUS_NOW
# (epoch seconds) the clock, for tests.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATUS="${DELEGATE_STATUS:-$SCRIPT_DIR/delegate-status}"

usage() {
  sed -n '/^# Usage:/,/^# It prints one/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2
  exit 2
}

die() {
  printf 'delegate-fire: %s\n' "$1" >&2
  exit "${2:-1}"
}

REPO=""
RESERVE=0
FORCE=0
DRY_RUN=0
EVENT=""
ACTION=""
NUMBER=""
EVENT_LABEL=""
SENDER=""
AUTHOR=""
HEAD_REF=""
REVIEWER=""

while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="${2:-}"; shift 2 ;;
    --reserve) RESERVE=1; shift ;;
    --force) FORCE=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --event) EVENT="${2:-}"; shift 2 ;;
    --action) ACTION="${2:-}"; shift 2 ;;
    --number) NUMBER="${2:-}"; shift 2 ;;
    --label) EVENT_LABEL="${2:-}"; shift 2 ;;
    --sender) SENDER="${2:-}"; shift 2 ;;
    --author) AUTHOR="${2:-}"; shift 2 ;;
    --head) HEAD_REF="${2:-}"; shift 2 ;;
    --reviewer) REVIEWER="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) die "unknown argument $1" 2 ;;
  esac
done
case "$NUMBER" in *[!0-9]*) die "--number takes a number" 2 ;; esac

CHECKOUT="$(git rev-parse --show-toplevel 2> /dev/null)" || die "run it from the project's checkout" 2
SETTINGS="$CHECKOUT/.claude/delegation.md"
[ -r "$SETTINGS" ] || die "this project has no .claude/delegation.md, so delegation is not set up here" 2

# A parameter from the settings file's Parameters table: | `name` | value |.
param() {
  sed -n "s/^|[[:space:]]*\`$1\`[[:space:]]*|[[:space:]]*\([^|]*[^|[:space:]]\)[[:space:]]*|.*/\1/p" "$SETTINGS" \
    | head -n 1 | tr -d '`'
}

ROSTER=()
read -r -a ROSTER <<< "$(param roster | tr ',' ' ')" || true
TEAM=0
[ "${#ROSTER[@]}" -eq 0 ] || TEAM=1

# Checked before the gate, so a workflow missing its secrets fails on every
# run, not only on the first one with work.
if [ "$DRY_RUN" -eq 0 ] && [ "$TEAM" -eq 0 ]; then
  [ -n "${DELEGATE_FIRE_URL:-}" ] || die "set DELEGATE_FIRE_URL to the scheduled task's API trigger URL" 2
  [ -n "${DELEGATE_FIRE_TOKEN:-}" ] || die "set DELEGATE_FIRE_TOKEN to the trigger's token" 2
fi
TRIGGERS="${DELEGATE_FIRE_TRIGGERS:-}"
if [ "$TEAM" -eq 1 ]; then
  if [ -z "$TRIGGERS" ] && [ "$DRY_RUN" -eq 0 ]; then
    die "set DELEGATE_FIRE_TRIGGERS to a JSON object mapping each roster login to {url, token, reserve_token?}" 2
  fi
  if [ -n "$TRIGGERS" ] && ! printf '%s' "$TRIGGERS" | jq -e 'type == "object"' > /dev/null 2>&1; then
    die "DELEGATE_FIRE_TRIGGERS is not a JSON object of logins" 2
  fi
fi

if [ -z "$REPO" ]; then
  REPO="$(git -C "$CHECKOUT" remote get-url origin 2> /dev/null || true)"
  REPO="${REPO#https://github.com/}"
  REPO="${REPO#git@github.com:}"
  REPO="${REPO%.git}"
fi
[ -n "$REPO" ] || die "no origin remote; pass --repo <owner/repo>" 2

# claim_ttl reads "45 minutes", "4 hours" or plain seconds.
ttl_seconds() {
  local n="${1%% *}" unit="${1#* }"
  case "$n" in ''|*[!0-9]*) die "claim_ttl in $SETTINGS is not a duration: $1" 2 ;; esac
  [ "$unit" = "$1" ] && unit="seconds"
  case "$unit" in
    minute|minutes) echo $((n * 60)) ;;
    hour|hours) echo $((n * 3600)) ;;
    second|seconds) echo "$n" ;;
    *) die "claim_ttl in $SETTINGS is not a duration: $1" 2 ;;
  esac
}

LABEL="$(param label)"
PREFIX="$(param branch_prefix)"
GATE_ARGS=(--repo "$REPO")
[ -z "$LABEL" ] || GATE_ARGS+=(--label "$LABEL")
v="$(param rank_labels)" && [ -n "$v" ] && GATE_ARGS+=(--rank-labels "$(printf '%s' "$v" | tr -d ' ')")
[ -z "$PREFIX" ] || GATE_ARGS+=(--prefix "$PREFIX")
v="$(param progress_label)" && [ -n "$v" ] && GATE_ARGS+=(--progress-label "$v")
v="$(param max_worktrees)" && [ -n "$v" ] && GATE_ARGS+=(--max-worktrees "$v")
v="$(param max_open_prs)" && [ -n "$v" ] && GATE_ARGS+=(--max-open-prs "$v")
v="$(param land)" && [ -n "$v" ] && GATE_ARGS+=(--land "$v")
v="$(param claim_ttl)" && [ -n "$v" ] && GATE_ARGS+=(--claim-ttl "$(ttl_seconds "$v")")
MAX_CHAINS="$(param max_chains)"
MAX_CHAINS="${MAX_CHAINS:-1}"
LABEL="${LABEL:-agent-ready}"
PREFIX="${PREFIX:-delegated/}"

ROUTING="$(param assignee_routing)"
case "${ROUTING:-off}" in
  off|on|strict) ;;
  *) die "assignee_routing in $SETTINGS takes off, on or strict: $ROUTING" 2 ;;
esac
if [ "$TEAM" -eq 1 ]; then
  GATE_ARGS+=(--assignee-routing strict)
elif [ "${ROUTING:-off}" != off ]; then
  GATE_ARGS+=(--assignee-routing "$ROUTING")
fi
PER_LOGIN="$(param max_chains_per_login)"
case "$PER_LOGIN" in *[!0-9]*) die "max_chains_per_login in $SETTINGS takes a whole number: $PER_LOGIN" 2 ;; esac

WEEKDAYS_ONLY="$(param weekdays_only)"
case "${WEEKDAYS_ONLY:-off}" in
  on|true|yes) WEEKDAYS_ONLY=1 ;;
  off|false|no) WEEKDAYS_ONLY=0 ;;
  *) die "weekdays_only in $SETTINGS takes on or off: $WEEKDAYS_ONLY" 2 ;;
esac

REREVIEW="$(param rereview)"
case "${REREVIEW:-off}" in
  on|true|yes) REREVIEW=1 ;;
  off|false|no) REREVIEW=0 ;;
  *) die "rereview in $SETTINGS takes on or off: $REREVIEW" 2 ;;
esac
REREVIEW_COMMAND="$(param rereview_command)"
REREVIEW_COMMAND="${REREVIEW_COMMAND:-/review-requests}"

# Report lines: printed, copied to the step summary, and, once the run is
# decided, fired=true|false to the step outputs.
say() {
  printf 'delegate-fire: %s\n' "$1"
  [ -z "${GITHUB_STEP_SUMMARY:-}" ] || printf 'delegate-fire: %s\n' "$1" >> "$GITHUB_STEP_SUMMARY"
}
output() {
  [ -z "${GITHUB_OUTPUT:-}" ] || printf 'fired=%s\n' "$1" >> "$GITHUB_OUTPUT"
}
report() { # fired line
  say "$2"
  output "$1"
}

# The trigger, the reserve token and the login one gate run uses. Without a
# roster they are the single-login environment; a roster run sets them for
# each login in turn.
G_URL="${DELEGATE_FIRE_URL:-}"
G_TOKEN="${DELEGATE_FIRE_TOKEN:-}"
G_RESERVE_TOKEN="${DELEGATE_FIRE_RESERVE_TOKEN:-}"
G_RESERVE="$RESERVE"
G_LOGIN=""
G_AS_ASSIGNED=""
# Set by each gate run: its report line, whether it fired, and whether
# anything failed. A run fires a pick without reserving it at most once per
# login, so RUN_UNRESERVED counts those against the shared free slots.
G_LINE=""
G_FIRED=false
G_FAILED=0
RUN_UNRESERVED=0

# POSTs one fire with the given text; prints the trigger's answer.
fire_one() {
  local body
  body="$(jq -nc --arg t "$1" '{text: $t}')"
  curl --fail-with-body --silent --show-error -X POST "$G_URL" \
    -H "Authorization: Bearer $G_TOKEN" \
    -H "anthropic-beta: experimental-cc-routine-2026-04-01" \
    -H "anthropic-version: 2023-06-01" \
    -H "Content-Type: application/json" \
    --data "$body" 2>&1
}

session_of() {
  printf '%s' "$1" | jq -r '.claude_code_session_id // .session_id // "unknown session"' 2> /dev/null || echo "unknown session"
}

if [ "$WEEKDAYS_ONLY" -eq 1 ] && [ "$FORCE" -eq 0 ]; then
  day="$(jq -nr --argjson n "${DELEGATE_STATUS_NOW:-$(date +%s)}" '$n | strftime("%u")')"
  if [ "$day" -gt 5 ]; then
    report false "weekend (weekdays_only is on)"
    exit 0
  fi
fi

cd "$CHECKOUT"

# Splits PR numbers into UNCLAIMED and CLAIMED ("PR #n by <session>"),
# re-reading each one's live claim now, just before a fire.
UNCLAIMED=()
CLAIMED=()
recheck() {
  local n out holder
  UNCLAIMED=()
  CLAIMED=()
  for n in "$@"; do
    out="$("$STATUS" holder "$n" "${GATE_ARGS[@]}")" || die "reading the claim on PR #$n failed; see the lines above"
    holder="$(printf '%s' "$out" | jq -r '.holder // empty')"
    if [ -n "$holder" ]; then CLAIMED+=("PR #$n by $holder"); else UNCLAIMED+=("$n"); fi
  done
}
claimed_text() {
  local IFS=,
  printf '%s' "${CLAIMED[*]}" | sed 's/,/, /g'
}

# The reservations write as the delegator's login. Every other call keeps
# GH_TOKEN, which in GitHub Actions is the workflow token: it reads PRs,
# reviews and timelines that a narrowly scoped reserve token cannot.
reserve() {
  if [ -n "$G_RESERVE_TOKEN" ]; then
    GH_TOKEN="$G_RESERVE_TOKEN" "$STATUS" "$@"
  else
    "$STATUS" "$@"
  fi
}

# One gate run: decide for one login and fire its trigger as needed. Sets
# G_LINE, G_FIRED and G_FAILED; a gate read that fails exits.
gate() {
  local args=("${GATE_ARGS[@]}") gate lease action reasons free holders why summary cap held room answer
  G_LINE=""
  G_FIRED=false
  [ -z "$G_AS_ASSIGNED" ] || args+=(--as-assigned "$G_AS_ASSIGNED")
  # --picks also lists, as `finish`, the PRs a finishing session would act on.
  gate="$("$STATUS" next-action "${args[@]}" --picks "$MAX_CHAINS")" || die "next-action failed; see the lines above"
  lease="$("$STATUS" lease status "${GATE_ARGS[@]}" --max-chains "$MAX_CHAINS")" || die "lease status failed; see the lines above"

  action="$(printf '%s' "$gate" | jq -r '.action')"
  reasons="$(printf '%s' "$gate" | jq -r '.reasons | join("; ")')"
  free="$(printf '%s' "$lease" | jq -r '.free')"
  holders="$(printf '%s' "$lease" | jq -r '.holders | join(", ")')"
  cap=""
  if [ "$TEAM" -eq 1 ]; then
    # A slot this run fired for without reserving is not on the lease yet.
    free=$((free > RUN_UNRESERVED ? free - RUN_UNRESERVED : 0))
    if [ -n "$PER_LOGIN" ]; then
      held="$(printf '%s' "$lease" | jq -r --arg l "$G_LOGIN" '.by_login[$l] // 0')"
      room=$((PER_LOGIN > held ? PER_LOGIN - held : 0))
      if [ "$room" -lt "$free" ]; then
        free="$room"
        [ "$room" -gt 0 ] || cap="cap ($held/$PER_LOGIN)"
      fi
    fi
  fi

  why=""
  if [ "$action" = idle ]; then
    why="idle ($reasons)"
  elif [ "$action" = pick ] && [ "$free" -eq 0 ]; then
    why="${cap:-full ($holders)}"
  fi

  summary="$action: $reasons"
  if [ "$action" != pick ] && [ "$free" -eq 0 ]; then
    summary="$summary; the lease is full, so finish only"
  fi

  if [ "$G_RESERVE" -eq 0 ] || [ "$FORCE" -eq 1 ]; then
    gate_one
  else
    gate_reserve
  fi
}

# Without reservations: at most one fire.
gate_one() {
  if [ -n "$why" ]; then
    if [ "$FORCE" -eq 0 ]; then
      G_LINE="$why"
      return
    fi
    summary="forced; the gate said $why"
  elif [ "$FORCE" -eq 0 ] && { [ "$action" = watch ] || [ "$action" = land ]; } \
    && printf '%s' "$gate" | jq -e 'has("finish")' > /dev/null; then
    # shellcheck disable=SC2046
    recheck $(printf '%s' "$gate" | jq -r '.finish[]')
    if [ "${#UNCLAIMED[@]}" -eq 0 ]; then
      if [ "$free" -gt 0 ] && printf '%s' "$gate" | jq -e '(.picks // []) != []' > /dev/null; then
        summary="pick: $(printf '%s' "$gate" | jq -r '[.reasons[] | select(startswith("issue #"))] | join("; ")')"
      else
        G_LINE="claimed ($(claimed_text))"
        return
      fi
    elif [ "${#CLAIMED[@]}" -gt 0 ]; then
      summary="$summary; skipped $(claimed_text | sed 's/PR #\([0-9]*\) by /PR #\1, claimed by /g')"
    fi
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    G_LINE="would fire ($summary)"
    return
  fi
  if ! answer="$(fire_one "Started by delegate-fire. $summary")"; then
    [ "$TEAM" -eq 1 ] || die "the trigger refused the fire: $answer"
    G_LINE="failed: the trigger refused the fire: $answer"
    G_FAILED=1
    return
  fi
  [ "$free" -eq 0 ] || RUN_UNRESERVED=$((RUN_UNRESERVED + 1))
  G_FIRED=true
  G_LINE="fired ($summary); trigger answered $answer"
}

# With reservations: a reserved chain for each pick up to the free slots,
# and one session to finish the PRs no session holds.
gate_reserve() {
  local picks finish_prs finish fired=() failed=() n name taken slot ticket marker text line
  picks="$(printf '%s' "$gate" | jq -r --argjson k "$free" '[.picks // [] | .[].number][:$k] | .[]')"
  finish_prs="$(printf '%s' "$gate" | jq -r '.finish // [] | .[]')"
  finish="$(printf '%s' "$finish_prs" | sed 's/^/#/' | paste -sd, - | sed 's/,/, /g')"
  if [ -z "$picks" ] && [ -z "$finish" ]; then
    G_LINE="${why:-idle ($reasons)}"
    return
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    line="would fire"
    [ -z "$picks" ] || line="$line a chain for each of $(printf '%s' "$picks" | sed 's/^/#/' | paste -sd, - | sed 's/,/, /g')"
    [ -z "$finish" ] || line="$line; one session to finish PRs $finish"
    G_LINE="$line ($reasons)"
    return
  fi

  CLAIMED=()
  for n in $picks; do
    name="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    if ! taken="$(reserve lease take "${GATE_ARGS[@]}" --max-chains "$MAX_CHAINS" --session "$name" 2> "$ERR")"; then
      case "$taken" in
        *'"result":"full"'*) break ;; # Another chain took the last slot.
      esac
      failed+=("#$n: lease take failed: $(tail -n 1 "$ERR")")
      continue
    fi
    slot="$(printf '%s' "$taken" | jq -r '.id')"
    if ! ticket="$(reserve ticket set "$n" "${GATE_ARGS[@]}" --session "$name" --chain "$name" 2> "$ERR")"; then
      reserve lease release "$slot" "${GATE_ARGS[@]}" --max-chains "$MAX_CHAINS" --session "$name" > /dev/null 2>&1 || true
      case "$ticket" in
        *'"result":"lost"'*) continue ;; # Another chain took the issue first.
      esac
      failed+=("#$n: ticket set failed: $(tail -n 1 "$ERR")")
      continue
    fi
    marker="$(printf '%s' "$ticket" | jq -r '.id')"
    text="Started by delegate-fire for issue #$n. Delegator hand-off from delegate-fire; session name $name; ticket #$n chain $name."
    if ! answer="$(fire_one "$text")"; then
      reserve ticket release "$n" "$marker" "${GATE_ARGS[@]}" --session "$name" --chain "$name" > /dev/null 2>&1 || true
      reserve lease release "$slot" "${GATE_ARGS[@]}" --max-chains "$MAX_CHAINS" --session "$name" > /dev/null 2>&1 || true
      failed+=("#$n: the trigger refused the fire: $answer")
      continue
    fi
    fired+=("#$n as $name ($(session_of "$answer"))")
  done

  if [ -n "$finish" ]; then
    # shellcheck disable=SC2086
    recheck $finish_prs
    finish=""
    [ "${#UNCLAIMED[@]}" -eq 0 ] || finish="$(printf '#%s, ' "${UNCLAIMED[@]}")"
    finish="${finish%, }"
  fi
  if [ -n "$finish" ]; then
    text="Started by delegate-fire to finish PRs $finish. $action: $reasons"
    if answer="$(fire_one "$text")"; then
      fired+=("finish $finish ($(session_of "$answer"))")
    else
      failed+=("finish $finish: the trigger refused the fire: $answer")
    fi
  fi

  if [ "${#fired[@]}" -gt 0 ]; then
    line="fired ${#fired[@]}: $(printf '%s; ' "${fired[@]}")"
    line="${line%; }"
    G_FIRED=true
  elif [ -z "$picks" ]; then
    line="fired none"
  else
    line="fired none (${why:-every pick was taken first})"
  fi
  if [ "${#CLAIMED[@]}" -gt 0 ]; then
    line="$line; claimed ($(claimed_text))"
  fi
  if [ "${#failed[@]}" -gt 0 ]; then
    line="$line; failed ${#failed[@]}: $(printf '%s; ' "${failed[@]}")"
    line="${line%; }"
    G_FAILED=1
  fi
  G_LINE="$line"
}

ERR="$(mktemp)"
trap 'rm -f "$ERR"' EXIT

# ---------------------------------------------------------------- one login

if [ "$TEAM" -eq 0 ]; then
  gate
  report "$G_FIRED" "$G_LINE"
  [ "$G_FAILED" -eq 0 ] || exit 1
  exit 0
fi

# ---------------------------------------------------------------- roster

ANY_FIRED=false
ANY_FAILED=0

on_roster() {
  local l
  for l in "${ROSTER[@]}"; do [ "$l" = "$1" ] && return 0; done
  return 1
}

# True when the login has a trigger, or when a dry run has no triggers to
# check against.
has_trigger() {
  [ -z "$TRIGGERS" ] && [ "$DRY_RUN" -eq 1 ] && return 0
  printf '%s' "$TRIGGERS" | jq -e --arg l "$1" '.[$l].url // empty | length > 0' > /dev/null
}

# Runs the gate as one login, with the issues to count as its own (a dry
# run's preview of the assignments it would have made), and reports it.
run_login() {
  local login="$1"
  if ! has_trigger "$login"; then
    say "$login: no trigger"
    return
  fi
  G_LOGIN="$login"
  G_AS_ASSIGNED="${2:-}"
  local entry
  entry="$(printf '%s' "${TRIGGERS:-null}" | jq -c --arg l "$login" '.[$l] // {}')"
  G_URL="$(printf '%s' "$entry" | jq -r '.url // ""')"
  G_TOKEN="$(printf '%s' "$entry" | jq -r '.token // ""')"
  G_RESERVE_TOKEN="$(printf '%s' "$entry" | jq -r '.reserve_token // ""')"
  G_RESERVE=0
  [ -z "$G_RESERVE_TOKEN" ] || G_RESERVE=1
  export DELEGATE_STATUS_LOGIN="$login"
  gate
  say "$login: $G_LINE"
  [ "$G_FIRED" = false ] || ANY_FIRED=true
  [ "$G_FAILED" -eq 0 ] || ANY_FAILED=1
}

# Assigns issue <n> to <login> as the lock between logins, unless this is a
# dry run. Prints nothing; returns 1, having reported why, when another
# human turned out to be assigned too.
assign_to() {
  local n="$1" login="$2" why="$3" out others
  if [ "$DRY_RUN" -eq 1 ]; then
    say "#$n: would assign to $login ($why)"
    return 0
  fi
  out="$("$STATUS" assign "$n" --to "$login" --repo "$REPO")" || die "assigning #$n to $login failed; see the lines above"
  others="$(printf '%s' "$out" | jq -r --arg l "$login" '[.assignees[] | select(. != $l)] | length')"
  if [ "$others" -gt 0 ]; then
    say "#$n: ambiguous assignees ($(printf '%s' "$out" | jq -r '.assignees | join(", ")'))"
    return 1
  fi
  say "#$n: assigned to $login ($why)"
}

route_label() {
  local out count owner as=""
  [ -n "$NUMBER" ] || die "--event issues takes --number" 2
  if [ "$EVENT_LABEL" != "$LABEL" ]; then
    say "ignored (label $EVENT_LABEL is not $LABEL)"
    return
  fi
  out="$("$STATUS" assignees "$NUMBER" --repo "$REPO")" || die "reading the assignees of #$NUMBER failed; see the lines above"
  count="$(printf '%s' "$out" | jq '.assignees | length')"
  if [ "$count" -gt 1 ]; then
    say "#$NUMBER: ambiguous assignees ($(printf '%s' "$out" | jq -r '.assignees | join(", ")'))"
    return
  fi
  if [ "$count" -eq 1 ]; then
    owner="$(printf '%s' "$out" | jq -r '.assignees[0]')"
    if ! on_roster "$owner"; then
      say "#$NUMBER: assigned to $owner, who is not on the roster"
      return
    fi
  else
    owner="$SENDER"
    if [ -z "$owner" ] || ! on_roster "$owner"; then
      say "#$NUMBER: labelled by ${owner:-nobody known}, who is not on the roster"
      return
    fi
    if ! has_trigger "$owner"; then
      say "$owner: no trigger"
      return
    fi
    assign_to "$NUMBER" "$owner" "labelled by $owner" || return 0
    [ "$DRY_RUN" -eq 0 ] || as="$NUMBER"
  fi
  run_login "$owner" "$as"
}

route_pr() {
  [ -n "$NUMBER" ] || die "--event $EVENT takes --number" 2
  case "$HEAD_REF" in
    "$PREFIX"*) ;;
    *) say "ignored (PR #$NUMBER is not a delegated PR)"; return ;;
  esac
  if [ -z "$AUTHOR" ] || ! on_roster "$AUTHOR"; then
    say "PR #$NUMBER: opened by ${AUTHOR:-nobody known}, who is not on the roster"
    return
  fi
  run_login "$AUTHOR"
}

route_all() {
  local out issue n labeller login as=""
  out="$("$STATUS" unassigned "${GATE_ARGS[@]}")" || die "listing the unassigned issues failed; see the lines above"
  while IFS= read -r issue; do
    [ -n "$issue" ] || continue
    n="$(printf '%s' "$issue" | jq -r '.number')"
    labeller="$(printf '%s' "$issue" | jq -r '.labeller // empty')"
    if [ -z "$labeller" ]; then
      say "#$n: skipped (no labeled event)"
    elif ! on_roster "$labeller"; then
      say "#$n: skipped (labelled by $labeller, who is not on the roster)"
    elif ! has_trigger "$labeller"; then
      say "#$n: skipped (labelled by $labeller, who has no trigger)"
    elif assign_to "$n" "$labeller" "labelled by $labeller" && [ "$DRY_RUN" -eq 1 ]; then
      as="$as$labeller $n
"
    fi
  done < <(printf '%s' "$out" | jq -c '.issues[]')
  for login in "${ROSTER[@]}"; do
    run_login "$login" "$(printf '%s' "$as" | awk -v l="$login" '$1 == l { print $2 }' | paste -sd, -)"
  done
}

# A review_requested event on a delegated PR: wake the requested reviewer's
# review-requests task for a re-review, only when it is one (see the header).
route_rereview() {
  local entry out open reviewed head answer
  [ -n "$NUMBER" ] || die "--event pull_request takes --number" 2
  if [ "$REREVIEW" -eq 0 ]; then
    say "ignored (pull_request.review_requested; rereview is off)"
    return
  fi
  case "$HEAD_REF" in
    "$PREFIX"*) ;;
    *) say "ignored (PR #$NUMBER is not a delegated PR)"; return ;;
  esac
  if [ -z "$REVIEWER" ] || ! on_roster "$REVIEWER"; then
    say "PR #$NUMBER: review requested from ${REVIEWER:-nobody known}, who is not on the roster"
    return
  fi
  if [ "$REVIEWER" = "$AUTHOR" ]; then
    say "ignored (PR #$NUMBER: $REVIEWER is its author)"
    return
  fi
  entry="$(printf '%s' "${TRIGGERS:-null}" | jq -c --arg l "$REVIEWER" '.[$l] // {}')"
  if [ "$(printf '%s' "$entry" | jq -r '.review_url // ""')" = "" ] && ! { [ -z "$TRIGGERS" ] && [ "$DRY_RUN" -eq 1 ]; }; then
    say "$REVIEWER: no review trigger (PR #$NUMBER waits in their review queue)"
    return
  fi
  out="$("$STATUS" rereview "$NUMBER" --repo "$REPO")" || die "reading the reviews of PR #$NUMBER failed; see the lines above"
  if [ "$(printf '%s' "$out" | jq -r '.reviewer // ""')" != "$REVIEWER" ]; then
    say "$REVIEWER: PR #$NUMBER has no review-requests review of theirs to follow up; not a re-review"
    return
  fi
  open="$(printf '%s' "$out" | jq -r '.open | length')"
  reviewed="$(printf '%s' "$out" | jq -r '.reviewed_head')"
  head="$(printf '%s' "$out" | jq -r '.head')"
  if [ "$open" -eq 0 ]; then
    say "$REVIEWER: nothing to re-review on PR #$NUMBER (no open blocking or should fix thread)"
    return
  fi
  if [ "$reviewed" = "$head" ]; then
    say "$REVIEWER: PR #$NUMBER is already reviewed at $head"
    return
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    say "$REVIEWER: would fire a re-review of PR #$NUMBER ($open open threads)"
    return
  fi
  G_URL="$(printf '%s' "$entry" | jq -r '.review_url')"
  G_TOKEN="$(printf '%s' "$entry" | jq -r '.review_token // ""')"
  if ! answer="$(fire_one "$REREVIEW_COMMAND $REPO#$NUMBER")"; then
    say "$REVIEWER: failed: the review trigger refused the fire: $answer"
    ANY_FAILED=1
    return
  fi
  ANY_FIRED=true
  say "$REVIEWER: fired a re-review of PR #$NUMBER ($open open threads); trigger answered $answer"
}

case "$EVENT" in
  issues)
    if [ "$ACTION" = labeled ]; then route_label; else say "ignored (issues.$ACTION)"; fi ;;
  pull_request)
    case "$ACTION" in
      ready_for_review|closed) route_pr ;;
      review_requested) route_rereview ;;
      *) say "ignored (pull_request.$ACTION)" ;;
    esac ;;
  pull_request_review)
    if [ "$ACTION" = submitted ]; then route_pr; else say "ignored (pull_request_review.$ACTION)"; fi ;;
  schedule|workflow_dispatch|'') route_all ;;
  *) say "ignored (event $EVENT)" ;;
esac
output "$ANY_FIRED"
[ "$ANY_FAILED" -eq 0 ] || exit 1
